# Porta da API
PORT=3333

# Conexão com o PostgreSQL (os valores abaixo batem com o docker-compose.yml)
DATABASE_URL=postgres://finpulse:finpulse@localhost:5432/finpulse

# Banco usado apenas pelos testes automatizados (é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgres://finpulse:finpulse@localhost:5432/finpulse_test

# Troque por um valor longo e aleatório. Nunca suba o .env real para o GitHub.
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Origem do front-end liberada no CORS
CORS_ORIGIN=http://localhost:5173

# Cotações: "live" consulta CoinGecko e AwesomeAPI; "mock" gera preços simulados (não usa internet)
MARKET_MODE=live
# Intervalo entre consultas, em milissegundos (60000 = 1 minuto)
MARKET_REFRESH_MS=60000
# Moedas acompanhadas (cotadas em reais)
MARKET_CURRENCIES=USD,EUR,GBP

# Chaves opcionais (gratuitas) para limites maiores
COINGECKO_API_KEY=
AWESOMEAPI_TOKEN=
